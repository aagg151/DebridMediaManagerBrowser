<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Real-Debrid uses HTTPS; some direct download hosts may serve over HTTP, so allow cleartext. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
